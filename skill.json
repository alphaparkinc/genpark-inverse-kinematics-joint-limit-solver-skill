{
  "name": "genpark-inverse-kinematics-joint-limit-solver-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - 6-DOF robotic manipulator Cartesian target pose to joint angle inverse kinematics solver enforcing physical angle limits.",
  "homepage": "https://genpark.ai/mcp",
  "author": "genpark",
  "category": "edge-robotics",
